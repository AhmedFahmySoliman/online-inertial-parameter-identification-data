function Figure9(I2, I3)

load('../data/CompactData/Figure9_Stats.mat','Figure9Data')

sub = I2;
if length(sub) ~= 1
    error('invalid selection')
end

if ismember(sub, Figure9Data.SelectedExp)
    k = find(Figure9Data.SelectedExp == sub, 1);
elseif ismember(sub, 1:numel(Figure9Data.SelectedExp))
    k = sub;
else
    error('invalid selection. Available original experiment indices are: %s', ...
        mat2str(Figure9Data.SelectedExp))
end

Time = Figure9Data.Time;
eps_err = Figure9Data.eps_err;

D = Figure9Data.Exp(k);

figure;
set(gcf,'Position',[100 100 950 350])

%% Left subplot: normalized parameter error
subplot(2,2,1); hold on; grid on; box on

plot(Time, D.Err_Prop, 'color','r',       'LineWidth',2)
plot(Time, D.Err_RSDP, 'color',[0 0.6 0], 'LineWidth',2)
plot(Time, D.Err_RDPM, 'color','b',       'LineWidth',2)

yline(eps_err, 'k--', 'LineWidth',1.5)

if ~isnan(D.Ts_Prop)
    xline(D.Ts_Prop, 'r--', 'LineWidth',1.5)
end
if ~isnan(D.Ts_RSDP)
    xline(D.Ts_RSDP, '--', 'Color',[0 0.6 0], 'LineWidth',1.5)
end
if ~isnan(D.Ts_RDPM)
    xline(D.Ts_RDPM, 'b--', 'LineWidth',1.5)
end

xlim([0 13])
xlabel('Time [s]', 'Interpreter','latex')
ylabel('Parameter convergence [-]', 'Interpreter','latex')

legend({'Proposed','RSDP','RDPM','$\epsilon_\pi$'}, 'Interpreter','latex', 'Location','northeast')

set(gca, 'FontName','Times New Roman', 'FontSize',13, 'LineWidth',1)

%% Right subplot: representative hip mass parameter
subplot(2,2,2); hold on; grid on; box on
yyaxis right
p1 = plot(Time, D.Mass_Prop(:,1), 'color','r', 'LineWidth',2,'LineStyle','-');
ylim([0 60])
ylabel('Floating Base Mass [kg]', 'Interpreter','latex', 'FontSize',24)

yyaxis left
p2 = plot(Time, D.Mass_Prop(:,2), 'color',[0 0.6 0], 'LineWidth',2,'LineStyle','-');
p3 = plot(Time, D.Mass_Prop(:,3), 'color','b', 'LineWidth',2,'LineStyle','-');
p4 = plot(Time, D.Mass_Prop(:,4), 'color',[0.6,0.5,0.05], 'LineWidth',2,'LineStyle','-');
p5 = plot(Time, D.Mass_Prop(:,5), 'color','k', 'LineWidth',2,'LineStyle','-');
ylim([0 40]), xlim([0 13])

xlim([0 13])
xlabel('Time [s]', 'Interpreter','latex')
ylabel('Link Masses [kg]', 'Interpreter','latex', 'FontSize',24)

ax = gca;
ax.YAxis(1).Color = [0 0 0];
ax.YAxis(2).Color = [1 0 0];

legend([p1 p2 p3 p4 p5],{'m_{fb}','m_h','m_{th}','m_{sh}','m_f'},'NumColumns',3, 'FontSize',24);

set(gca, 'FontName','Times New Roman', 'FontSize',20, 'LineWidth',1)

%% Plot Simulation Parameters
eps_err    = 0.05;
eps_var    = 0.01;
dwell_time = 0.5;

load('../data/CompactData/Simulation_Compact_All.mat','Compact')



%% Plot Representative mass
s = I3; l = length(s);
if (l~=1 || s>12 || s<1 )
    error('invalid selection')
end

Time = cell2mat(Compact.Time(s));
m_fb = Compact.Prop(s).PI(:,10);
m_h = Compact.Prop(s).PI(:,20);
m_th = Compact.Prop(s).PI(:,30);
m_sh = Compact.Prop(s).PI(:,40);
m_f = Compact.Prop(s).PI(:,50);

PI_Prop = Compact.Prop(s).PI;
PI_RSDP = Compact.Prop(s).PI;
PI_RDPM = Compact.Prop(s).PI;


subplot(2,2,4)
hold on

yyaxis right
p1 = plot(Time,m_fb,'r', 'LineStyle','-', 'Marker', 'none','LineWidth',1);
ylim([0 90])
ylabel('Floating Base Mass [kg]', 'Interpreter','latex', 'FontSize',24)
ax = gca;
ax.YColor = 'r';

yyaxis left
ax = gca;
ax.YColor = 'k';
p2 = plot(Time,m_h,'color',[0,0.6,0], 'LineStyle','-', 'Marker', 'none','LineWidth',1);
p3 = plot(Time,m_th,'b', 'LineStyle','-', 'Marker', 'none','LineWidth',1);
p4 = plot(Time,m_sh,'k', 'LineStyle','-', 'Marker', 'none','LineWidth',1);
p5 = plot(Time,m_f,'color',[0.6,0.5,0.05], 'LineStyle','-', 'Marker', 'none','LineWidth',1);grid on, grid minor, box on
ylabel('Link Masses [kg]', 'Interpreter','latex', 'FontSize',24), xlabel('Time [s]')
legend([p1 p2 p3 p4 p5],{'m_{fb}','m_h','m_{th}','m_{sh}','m_f'},'NumColumns',5);
xlim([0 14]), ylim([0 35])
set(gca,'FontName', 'Times New Roman','FontSize', 12,'LineWidth',1)
hold off

subplot(2,2,1),set(gca,'position',[0.059304703476483,0.588104222556988,0.3849044896821,0.37791519491874]);
subplot(2,2,2),set(gca,'position',[0.50962767003043,0.588104224100151,0.409595233855051,0.377915193375577]);
subplot(2,2,3),set(gca,'position',[0.061597367000128,0.114267014797825,0.382121212121212,0.376024247338097]);
subplot(2,2,4),set(gca,'position',[0.508870094272854,0.114267014797825,0.408307819837576,0.37926049329279]);
set(gcf, 'position', [90     1   978   954])

% saveCurrentFigure('Figure9');

disp('====================================================');
disp(' Figure saved successfully!');
disp(' Please, display the results by left clicking');
disp('  "Figure9.png" in the "results" folder.');
disp('====================================================');

end
